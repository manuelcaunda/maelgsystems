# =============================================================================
# MaelG Systems — configuração da plataforma
#
# Copia para `.env` e preenche. O `.env` NÃO vai para o git.
#
# A base de dados é a DEDICADA da plataforma (maelg). O maelgsystems nunca
# liga à base do produto (maelgest) — fala com o produto por HTTP, usando as
# credenciais guardadas na tabela `produto_acesso`.
# =============================================================================

# --- servidor ---
PORT=3000

# --- base de dados da plataforma (maelg) ---
MAELG_DB_HOST=localhost
MAELG_DB_PORT=3306
MAELG_DB_USER=
MAELG_DB_PASSWORD=
MAELG_DB_NAME=maelg

# --- sessao dos operadores ---
# Segredo para assinar o JWT da sessao. Gere um: openssl rand -hex 32
MAELG_JWT_SECRET=
# Horas que a sessao se mantem valida
MAELG_SESSAO_HORAS=12

# --- bootstrap do primeiro operador ---
# A plataforma nasce vazia e nao ha seed. A primeira conta cria-se a mao:
#
#     npm run criar-operador
#
# O comando pergunta o nome, email, papel e password. Nao ha valores no .env
# porque nao ha conta nenhuma para configurar.
MAELG_CREDENTIALS_KEY=<base64 de openssl rand -base64 32>
